generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model card_scheduling {
  card_id          String    @id @db.Uuid
  due_at           DateTime  @default(now()) @db.Timestamptz(6)
  stability        Float     @default(0)
  difficulty       Float     @default(0)
  state            Int       @default(0) @db.SmallInt
  reps             Int       @default(0)
  lapses           Int       @default(0)
  last_reviewed_at DateTime? @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  cards            cards     @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([due_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cards {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deck_id         String           @db.Uuid
  front           String
  back            String
  position        Int              @default(0)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  card_scheduling card_scheduling?
  decks           decks            @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews         reviews[]

  @@unique([deck_id, position])
  @@index([deck_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model decks {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  subject_id  String?   @db.Uuid
  title       String
  description String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  archived_at DateTime? @db.Timestamptz(6)
  cards       cards[]
  subjects    subjects? @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  card_id           String   @db.Uuid
  user_id           String   @db.Uuid
  rating            Int      @db.SmallInt
  reviewed_at       DateTime @default(now()) @db.Timestamptz(6)
  response_time_ms  Int?
  state_before      Int      @db.SmallInt
  state_after       Int      @db.SmallInt
  scheduler_version String   @default("fsrs")
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  cards             cards    @relation(fields: [card_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([card_id, reviewed_at], map: "reviews_card_reviewed_idx")
  @@index([user_id, reviewed_at], map: "reviews_user_reviewed_idx")
}

model sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subjects {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  decks      decks[]
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name    String
  email         String
  password_hash String
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)
  decks         decks[]
  reviews       reviews[]
  sessions      sessions[]
  subjects      subjects[]
}
