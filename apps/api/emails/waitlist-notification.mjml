<mjml>
  <mj-head>
    <mj-title>New mneia waitlist signup</mj-title>

    <mj-attributes>
      <mj-all
        font-family="Inter, Arial, sans-serif"
        color="#172022"
      />
      <mj-text
        font-size="16px"
        line-height="1.6"
        color="#718083"
      />
      <mj-button
        background-color="#075B3F"
        color="#FFFFFF"
        border-radius="8px"
        font-family="Inter, Arial, sans-serif"
        font-size="15px"
        font-weight="600"
        inner-padding="12px 20px"
      />
    </mj-attributes>

    <mj-style>
      .heading {
        font-family: "DM Sans", Arial, sans-serif;
        color: #172022;
      }

      .label {
        color: #718083;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .value {
        color: #172022;
        font-size: 16px;
      }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F4F7F7">
    <mj-section padding="40px 20px 20px">
      <mj-column>
        <mj-text
          align="center"
          font-family="DM Sans, Arial, sans-serif"
          font-size="28px"
          font-weight="700"
          color="#075B3F"
        >
          mneia
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 20px 40px">
      <mj-column
        background-color="#FFFFFF"
        border="1px solid #E4E8E8"
        border-radius="10px"
        padding="32px"
      >
        <mj-text
          css-class="heading"
          font-family="DM Sans, Arial, sans-serif"
          font-size="26px"
          font-weight="700"
          padding-bottom="8px"
        >
          New waitlist signup
        </mj-text>

        <mj-text padding-bottom="24px">
          Someone has joined the mneia waitlist.
        </mj-text>

        <mj-text css-class="label" padding-bottom="4px">
          Email
        </mj-text>

        <mj-text css-class="value" padding-bottom="20px">
          {DATA_VARIABLE:email}
        </mj-text>

        <mj-text css-class="label" padding-bottom="4px">
          Signed up
        </mj-text>

        <mj-text css-class="value" padding-bottom="20px">
          {DATA_VARIABLE:signupTime}
        </mj-text>

        <mj-text css-class="label" padding-bottom="4px">
          Source
        </mj-text>

        <mj-text css-class="value">
          {DATA_VARIABLE:source}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 20px 32px">
      <mj-column>
        <mj-text
          align="center"
          font-size="12px"
          color="#718083"
        >
          mneia · Study better. Remember longer.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>